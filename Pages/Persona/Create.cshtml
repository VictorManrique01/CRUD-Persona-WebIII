@page
@model HelloWorld.Pages.Persona.CreateModel
@{
    ViewData["Title"] = "Registrar persona";
}

<h1>Registrar persona</h1>

@if (Model.Paises.Count == 0)
{
    <div class="alert alert-warning">
        Primero debe existir al menos un país en la base de datos.
    </div>
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Nombre" class="form-label"></label>
        <input asp-for="Input.Nombre" class="form-control" />
        <span asp-validation-for="Input.Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.FechaNacimiento" class="form-label"></label>
        <input asp-for="Input.FechaNacimiento" type="date" class="form-control" />
        <span asp-validation-for="Input.FechaNacimiento" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.PaisId" class="form-label"></label>
        <select asp-for="Input.PaisId" asp-items="Model.Paises" class="form-select">
            <option value="0">Seleccione un país</option>
        </select>
        <span asp-validation-for="Input.PaisId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.NumeroPasaporte" class="form-label"></label>
        <input asp-for="Input.NumeroPasaporte" class="form-control" />
        <div class="form-text">Puede dejarlo vacío si la persona no tiene pasaporte.</div>
        <span asp-validation-for="Input.NumeroPasaporte" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.MateriasIds" class="form-label"></label>
        <select asp-for="Input.MateriasIds" asp-items="Model.Materias" class="form-select" multiple size="6"></select>
        <div class="form-text">Mantenga presionada la tecla Ctrl para seleccionar varias materias.</div>
        <span asp-validation-for="Input.MateriasIds" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-page="Index" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
